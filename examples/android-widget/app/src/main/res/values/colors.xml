<?xml version="1.0" encoding="utf-8"?>
<!--
    Palette for the redesigned widget.

    The supplied design renders white text on a light frosted surface, so every
    surface here is tuned a little deeper / more saturated than the mockup in
    order to keep the counters readable against the bright glass artwork that
    sits behind them.
-->
<resources>

    

    <!-- Metric cards: tinted glass, darker at the top-left like the design -->
    <color name="card_learning_start">#9E3A57B8</color>
    <color name="card_learning_end">#806E8FE0</color>
    <color name="card_known_start">#A30A6E62</color>
    <color name="card_known_end">#8535A894</color>
    <color name="card_stroke">#6EFFFFFF</color>

    <!-- Metric tiles -->
    <color name="tile_learning_start">#FF5B8DF5</color>
    <color name="tile_learning_end">#FF3B6BE8</color>
    <color name="tile_known_start">#FF3DBE9A</color>
    <color name="tile_known_end">#FF2FA07F</color>
    <color name="tile_glyph">#FFFFFFFF</color>
    <color name="tile_check">#FF2FA07F</color>

    <!-- Progress bars -->
    <color name="progress_track">#70FFFFFF</color>
    <color name="learning_fill_start">#FF4C8DFF</color>
    <color name="learning_fill_end">#FF3A7BF5</color>
    <color name="known_fill_start">#FF3DE0B0</color>
    <color name="known_fill_end">#FF2ED8A3</color>

    <!-- Hinomaru medallion -->
    <color name="flag_disc_core">#FFFFFFFF</color>
    <color name="flag_disc_mid">#FFEEF2FB</color>
    <color name="flag_disc_edge">#FFDFE6F5</color>
    <color name="flag_red_core">#FFFF7A8C</color>
    <color name="flag_red_mid">#FFE0223F</color>
    <color name="flag_red_edge">#FFC3123A</color>

    <!-- Header blob -->
    <color name="blob_core">#38FFFFFF</color>
    <color name="blob_edge">#08FFFFFF</color>

    <!-- Text -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#99FFFFFF</color>
    <color name="text_label">#E6FFFFFF</color>
    <color name="text_shadow">#660E2A52</color>
    <color name="chevron">#B8FFFFFF</color>

    <!-- Error banner -->
    <color name="error_fill">#99E05A5A</color>
    <color name="error_stroke">#80FFFFFF</color>
    <color name="error_text">#FFFFFFFF</color>

    <!-- "Due today" chip -->
    <color name="chip_fill">#66203252</color>
    <color name="chip_stroke">#59FFFFFF</color>
    <color name="chip_text">#FFFFFFFF</color>

    <!-- Configuration screen (light) -->
    <color name="bg_light">#E9F2FC</color>
    <color name="input_bg">#FFFFFFFF</color>
    <color name="input_border">#FFC6DCF0</color>
    <color name="text_ink">#FF173553</color>
    <color name="text_ink_muted">#FF6D8CAA</color>
    <color name="accent">#FF3A6BE0</color>
</resources>