<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: deep Migaku plum surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Frosted glass overlay -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Top highlight: violet sheen for the glass effect -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="56dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#4D7C3AED"
                android:centerColor="#1A7C3AED"
                android:endColor="#007C3AED" />
        </shape>
    </item>
    <!-- Bottom glow: brand rose -->
    <item android:top="64dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="90"
                android:startColor="#00E11D48"
                android:centerColor="#14E11D48"
                android:endColor="#33E11D48" />
        </shape>
    </item>
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1.5dp" android:color="@color/widget_glass_border" />
        </shape>
    </item>
</layer-list>