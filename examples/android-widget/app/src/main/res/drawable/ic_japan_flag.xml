        </aapt:attr>
    </path>

    <path android:pathData="M24,24 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="20"
                android:centerY="19"
                android:gradientRadius="15"
                android:type="radial">
                <item android:color="@color/flag_red_core" android:offset="0" />
                <item android:color="@color/flag_red_mid" android:offset="0.55" />
                <item android:color="@color/flag_red_edge" android:offset="1" />
            </gradient>
        </aapt:attr>
