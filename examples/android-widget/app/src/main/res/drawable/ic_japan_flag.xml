    android:width="34dp"
    android:height="34dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <path android:pathData="M24,0 A24,24 0 1,1 23.99,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="17"
                android:centerY="15"
                android:gradientRadius="26"
                android:type="radial">
                <item android:color="@color/flag_disc_core" android:offset="0" />
                <item android:color="@color/flag_disc_mid" android:offset="0.65" />
                <item android:color="@color/flag_disc_edge" android:offset="1" />
