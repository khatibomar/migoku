<?xml version="1.0" encoding="utf-8"?>
<!-- Error banner shown when the Migoku API is unreachable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/error_fill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/error_stroke" />
        </shape>
    </item>
</layer-list>