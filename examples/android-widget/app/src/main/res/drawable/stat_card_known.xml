<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Known card - Migaku violet glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stat_known_bg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Glass highlight -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/stat_known_highlight"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1.2dp" android:color="@color/stat_known_border" />
        </shape>
    </item>
</layer-list>