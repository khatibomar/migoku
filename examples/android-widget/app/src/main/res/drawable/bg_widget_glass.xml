<?xml version="1.0" encoding="utf-8"?>
<!--
    Translucent glass surface for the widget (from 01-glass-widget-background.svg):
    a frosted diagonal sheen, a top highlight sweep and the two SVG strokes.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:centerColor="@color/widget_glass_center"
                android:endColor="@color/widget_glass_end"
                android:startColor="@color/widget_glass_start"
                android:type="linear" />
        </shape>
    </item>
    <!-- Top highlight sweep from the SVG -->
    <item android:top="2dp" android:bottom="52dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/widget_glass_highlight"
                android:centerColor="@color/widget_glass_highlight"
                android:endColor="@color/widget_glass_highlight"
                android:type="linear" />
        </shape>
    </item>
    <!-- Inner rim -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <stroke android:width="1dp" android:color="@color/widget_glass_inner_stroke" />
        </shape>
    </item>
    <!-- Outer stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1.5dp" android:color="@color/widget_glass_stroke" />
        </shape>
    </item>
</layer-list>
