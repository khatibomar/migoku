<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Badge background - Migaku rose glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/badge_ja_bg" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Glass highlight -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#59FB7185"
                android:endColor="#00FB7185" />
        </shape>
    </item>
    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/badge_ja_border" />
        </shape>
    </item>
</layer-list>