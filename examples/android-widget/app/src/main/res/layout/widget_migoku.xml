<?xml version="1.0" encoding="utf-8"?>
<!--
    Migoku widget, rebuilt around the supplied Japanese-learning-widget artwork.

    The design is a 1280x650 glass dashboard: a hinomaru medallion with the
    がんばろう！ greeting over the sky on the left, Mount Fuji / pagoda /
    cherry blossoms across the bottom, and the two metric cards on the right.

    Two things about RemoteViews shape this layout:

      * the artwork ships as a single plate (drawable-nodpi/widget_plate.webp)
        used as the widget background. It carries rounded corners with a feathered
        alpha edge, so the widget reads as glass over the wallpaper instead of a
        rectangle cut out of a picture. Splitting the plate into a sky band plus a
        landscape band so the picture could keep its proportions only produced a
        visible seam and sliced Fuji's summit off, so the design is drawn once and
        scaled to whatever cell the launcher hands over;
      * weights, not fixed margins, drive the columns, so the design survives both
        a wide 4x2 placement and a much squarer resized one.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_plate">

    <!-- ============ Content: greeting on the left, cards on the right ============ -->
    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Greeting. Tapping anywhere in this column opens the settings screen. -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.95"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="10dp">

            <LinearLayout
                android:id="@+id/layout_header_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/header_blob"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_header_blob"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/img_jp_flag"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/flag_description"
                        android:src="@drawable/ic_japan_flag" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="@color/text_shadow"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/widget_title"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-rounded"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="@color/text_shadow"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="@string/widget_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Metric cards -->
        <LinearLayout
            android:id="@+id/layout_stats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:paddingTop="13dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <!-- Error state: the pill is centred in the column instead of hanging off the top. -->
            <FrameLayout
                android:id="@+id/layout_error"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_error_banner"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/error_text"
                    android:textSize="11sp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layout_stats_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/card_learning"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_learning"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="11dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_stat_learning" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-rounded"
                            android:maxLines="1"
                            android:shadowColor="@color/text_shadow"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:text="@string/label_learning"
                            android:textColor="@color/text_label"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_learning_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-rounded"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:shadowColor="@color/text_shadow"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="4"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_learning_total"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-rounded"
                                android:includeFontPadding="false"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="/ 0"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_learning"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="7dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_learning" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="11dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_known"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_known"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="11dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_stat_known" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-rounded"
                            android:maxLines="1"
                            android:shadowColor="@color/text_shadow"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:text="@string/label_known"
                            android:textColor="@color/text_label"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_known_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-rounded"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:shadowColor="@color/text_shadow"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="4"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_known_total"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-rounded"
                                android:includeFontPadding="false"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="/ 0"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_known"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="7dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_known" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="11dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>