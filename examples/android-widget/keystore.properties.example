# Copy this file to keystore.properties and fill in your values.
# keystore.properties is gitignored; never commit keys or passwords.
# Relative paths are resolved against this project's app/ module directory;
# use an absolute path to be safe.

storeFile=/absolute/path/to/your/release.keystore
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password